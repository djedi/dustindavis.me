---
title: Dustin Davis
description: Software engineer who improves systems through automation. Building EnvelopeBudget, Red Seam, and the occasional weekend project.
fullWidth: true
---

<section class="hero">
  <div class="hero__copy">
    <p class="hero__eyebrow">
      <span class="dot"></span> Software Engineer · Utah
    </p>
    <h1>
      Hi, I'm Dustin. I make systems
      <span class="accent">do the boring parts</span> for me.
    </h1>
    <p class="hero__lede">
      Full-stack engineer, people manager, and relentless automator. I build
      products, unblock teams, and write about what I learn along the way.
    </p>
    <p class="hero__typed">
      <span class="prompt" style="color: var(--accent-2)">$</span>
      <span id="typed"></span><span class="cursor">_</span>
    </p>
    <div class="cta-row" style="margin-top: 1.6rem">
      <a
        class="hero-cta hero-cta--eb"
        href="https://envelopebudget.com"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="hero-cta__icon"><img src="/images/eb.png" alt="" /></span>
        <span class="hero-cta__body">
          <span class="hero-cta__brand">EnvelopeBudget</span>
          <span class="hero-cta__label">Simple budgeting that works</span>
        </span>
      </a>
      <a
        class="hero-cta hero-cta--rs"
        href="https://redseam.com"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="hero-cta__icon"><img src="/images/rs.png" alt="" /></span>
        <span class="hero-cta__body">
          <span class="hero-cta__brand">Red Seam</span>
          <span class="hero-cta__label">Need a site or app?</span>
        </span>
      </a>
    </div>
  </div>

  <div class="hero__portrait">
    <img src="/images/dustin.avif" alt="Dustin Davis" />
  </div>
</section>

<section class="section">
  <div class="section__label">
    <span class="prompt">$</span> <span class="cmd">ls</span> ~/blog --recent
  </div>

  <div class="post-list">
    {% set recentPosts = collections.blog | limit(5) %} {% for post in
    recentPosts %}
    <a
      class="post-card"
      aria-label="View {{ post.data.title }}"
      href="{{ post.url }}"
    >
      {% if post.data.banner %} {% set imagePath = post.inputPath |
      directoryPath %}
      <div class="post-card__media blog-post-box__media">
        {% responsiveImage imagePath + '/' + post.data.banner, post.data.title,
        "blog-image", 480 %}
      </div>
      {% endif %}
      <div class="post-card__body">
        <h3 class="post-card__title">{{ post.data.title }}</h3>
        {% if post.data.description %}
        <p class="post-card__desc">{{ post.data.description }}</p>
        {% endif %}
        <span class="post-card__more">read →</span>
      </div>
    </a>
    {% endfor %}
  </div>

  <div class="post-list__foot">
    <a class="link-arrow" aria-label="Visit blog page" href="/blog"
      >View all articles</a
    >
  </div>
</section>

<!-- Clicky -->
<script async data-id="101491563" src="//static.getclicky.com/js"></script>
<noscript
  ><p>
    <img
      alt="Clicky"
      width="1"
      height="1"
      src="//in.getclicky.com/101491563ns.gif"
    /></p
></noscript>

<script>
  ;(function () {
    var phrases = [
      "automate --the-tedious-stuff",
      "ship envelopebudget.com",
      "coach little-league --sport=baseball",
      "refactor legacy --without-fear",
      "make dirty-soda && write code",
    ]
    var el = document.getElementById("typed")
    if (!el || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      if (el) el.textContent = phrases[0]
      return
    }
    var pi = 0,
      ci = 0,
      deleting = false
    function tick() {
      var word = phrases[pi]
      el.textContent = word.substring(0, ci)
      if (!deleting) {
        if (ci < word.length) {
          ci++
          setTimeout(tick, 55)
        } else {
          deleting = true
          setTimeout(tick, 1600)
        }
      } else {
        if (ci > 0) {
          ci--
          setTimeout(tick, 28)
        } else {
          deleting = false
          pi = (pi + 1) % phrases.length
          setTimeout(tick, 350)
        }
      }
    }
    tick()
  })()
</script>
