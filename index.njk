---
title: Dustin Davis
description: Software engineer who improves systems through automation. Building EnvelopeBudget, Red Seam, and the occasional weekend project.
fullWidth: true
---

<section class="hero">
  <div class="hero__copy">
    <p class="hero__eyebrow">
      <span class="dot"></span> Software Engineer · Utah
    </p>
    <h1>
      Hi, I'm Dustin. I make systems
      <span class="accent">do the boring parts</span> for me.
    </h1>
    <p class="hero__lede">
      Full-stack engineer, people manager, and relentless automator. I build
      products, unblock teams, and write about what I learn along the way.
    </p>
    <p class="hero__typed">
      <span class="prompt" style="color: var(--accent-2)">$</span>
      <span id="typed"></span><span class="cursor">_</span>
    </p>
  </div>

  <div class="hero__portrait">
    <img src="/images/dustin-avatar-600.webp" srcset="/images/dustin-avatar-300.webp 300w, /images/dustin-avatar-600.webp 600w" sizes="(max-width: 640px) 190px, 300px" alt="Dustin Davis" width="600" height="600" />
    <span class="hero__portrait-tag" aria-hidden="true">// identity.verified</span>
  </div>
</section>

<section class="section">
  <div class="section__label">
    <span class="prompt">$</span> <span class="cmd">ls</span> ~/projects --featured
  </div>

  <ul class="portfolio-grid portfolio-grid--featured">
    {% for project in portfolio | selectattr("featured") | sort(false, false, "featured") %}
    <li class="portfolio-card">
      <a href="/portfolio/{{ project.slug }}/" class="portfolio-card__cover">
        <img src="{{ project.cover | replace('-cover.webp', '-cover-600.webp') }}" srcset="{{ project.cover | replace('-cover.webp', '-cover-400.webp') }} 400w, {{ project.cover | replace('-cover.webp', '-cover-600.webp') }} 600w, {{ project.cover | replace('-cover.webp', '-cover-800.webp') }} 800w, {{ project.cover }} 1200w" sizes="(max-width: 560px) 100vw, (max-width: 960px) 45vw, 240px" alt="{{ project.coverAlt }}" width="1200" height="630" loading="lazy" />
      </a>
      <div class="portfolio-card__body">
        <div class="portfolio-card__head">
          <img src="{{ project.icon }}" alt="" width="28" height="28" />
          <h2><a href="/portfolio/{{ project.slug }}/">{{ project.name }}</a></h2>
        </div>
        <p class="portfolio-card__meta">{{ project.tagline }}</p>
      </div>
    </li>
    {% endfor %}
  </ul>

  <div class="post-list__foot">
    <a class="link-arrow" href="/portfolio/">View all projects</a>
  </div>
</section>

<section class="section">
  <div class="section__label">
    <span class="prompt">$</span> <span class="cmd">ls</span> ~/blog --recent
  </div>

  <div class="post-list">
    {% set recentPosts = collections.blog | limit(5) %} {% for post in
    recentPosts %}
    <a
      class="post-card"
      href="{{ post.url }}"
    >
      {% if post.data.banner %} {% set imagePath = post.inputPath |
      directoryPath %}
      <div class="post-card__media blog-post-box__media">
        {% responsiveImage imagePath + '/' + post.data.banner, post.data.title, "blog-image", 480, "", "(max-width: 640px) 100vw, 220px", "lazy" %}
      </div>
      {% endif %}
      <div class="post-card__body">
        <h3 class="post-card__title">{{ post.data.title }}</h3>
        {% if post.data.description %}
        <p class="post-card__desc">{{ post.data.description }}</p>
        {% endif %}
        <span class="post-card__more">read →</span>
      </div>
    </a>
    {% endfor %}
  </div>

  <div class="post-list__foot">
    <a class="link-arrow" href="/blog"
      >View all articles</a
    >
  </div>
</section>

<!-- Clicky -->
<script async data-id="101491563" src="https://static.getclicky.com/js"></script>
<noscript
  ><p>
    <img
      alt="Clicky"
      width="1"
      height="1"
      src="https://in.getclicky.com/101491563ns.gif"
    /></p
></noscript>

<script>
  ;(function () {
    var phrases = [
      "automate --the-tedious-stuff",
      "ship envelopebudget.com",
      "coach little-league --sport=baseball",
      "refactor legacy --without-fear",
      "make dirty-soda && write code",
    ]
    var el = document.getElementById("typed")
    if (!el || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      if (el) el.textContent = phrases[0]
      return
    }
    var pi = 0,
      ci = 0,
      deleting = false
    function tick() {
      var word = phrases[pi]
      el.textContent = word.substring(0, ci)
      if (!deleting) {
        if (ci < word.length) {
          ci++
          setTimeout(tick, 55)
        } else {
          deleting = true
          setTimeout(tick, 1600)
        }
      } else {
        if (ci > 0) {
          ci--
          setTimeout(tick, 28)
        } else {
          deleting = false
          pi = (pi + 1) % phrases.length
          setTimeout(tick, 350)
        }
      }
    }
    tick()
  })()
</script>
