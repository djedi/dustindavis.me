---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
layout: false
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
  {%- if item.url and item.url.endsWith('/') and item.url != '/404.html' and not item.url.startsWith('/static/') and not item.data.noindex %}
  <url>
    <loc>https://dustindavis.me{{ item.url }}</loc>
  </url>
  {%- endif %}
{%- endfor %}
</urlset>
