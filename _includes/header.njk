<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/">
      <img src="/images/dustin-avatar-68.webp" alt="" width="34" height="34" />
      <span class="brand__name"><span class="prompt">~/</span>dustin-davis</span>
    </a>

    <button class="nav-toggle" aria-label="open menu" aria-expanded="false" aria-controls="primary-nav">≡</button>

    <div class="site-header__actions" style="display:flex; align-items:center; gap:0.5rem;">
      <nav class="nav-links" id="primary-nav" aria-label="Primary">
        {% for item in nav %}
          <a aria-label="{{ item.ariaLabel }}" href="{{ item.url }}"
             class="{% if page.url == item.url %}active{% endif %}"
             {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endfor %}
      </nav>
      <label class="holiday-switch" title="Site theme">
        <span class="sr-only">Site theme</span>
        <select id="holiday-select" aria-label="Site theme">
          <option value="auto">Auto (seasonal)</option>
          {% for t in themes %}<option value="{{ t.name }}">{{ t.icon }} {{ t.label }}</option>{% endfor %}
        </select>
      </label>
      <button type="button" class="fx-toggle" id="fx-toggle" aria-pressed="true" title="Background effects">fx</button>
      <fieldset class="theme-switch" role="radiogroup" aria-label="Color theme">
        <input type="radio" name="theme" id="theme-light" value="light" />
        <label for="theme-light" title="Light"><span aria-hidden="true">☀</span><span class="sr-only">Light</span></label>
        <input type="radio" name="theme" id="theme-dark" value="dark" />
        <label for="theme-dark" title="Dark"><span aria-hidden="true">☾</span><span class="sr-only">Dark</span></label>
        <input type="radio" name="theme" id="theme-system" value="system" checked />
        <label for="theme-system" title="System"><span aria-hidden="true">◐</span><span class="sr-only">System</span></label>
      </fieldset>
    </div>
  </div>
</header>
