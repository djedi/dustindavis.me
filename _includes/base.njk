<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <!-- No-flash theme: apply saved / preferred theme before paint -->
    <script>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YTTL61KN8J"></script>
    <script type="text/javascript">
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-YTTL61KN8J');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..600&family=JetBrains+Mono:ital,wght@0,400..800;1,400..600&display=swap" rel="stylesheet" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/lazysizes/5.3.2/lazysizes.min.js" async></script>

    <link rel="stylesheet" href="/static/site.css" />

    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{% if title %}{{ title }}{% else %}Dustin Davis{% endif %}</title>
    <meta name="image" content="https://dustindavis.me/images/og-default.png" />
    <meta property="og:url" content="https://dustindavis.me{{ page.url }}" />
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}Dustin Davis{% endif %}" />
    <meta property="og:description" content="{% if description %}{{ description }}{% else %}Software engineer who improves systems through automation.{% endif %}" />
    <meta property="og:image" content="https://dustindavis.me/images/og-default.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@DustinDavis" />
    <meta name="twitter:title" content="{% if title %}{{ title }}{% else %}Dustin Davis{% endif %}" />
    <meta name="twitter:description" content="{% if description %}{{ description }}{% else %}Software engineer who improves systems through automation.{% endif %}" />
    <meta name="twitter:image" content="https://dustindavis.me/images/og-default.png" />
    <meta name="description" content="{% if description %}{{ description }}{% else %}Software engineer who improves systems through automation.{% endif %}" />
    <meta name="keywords" content="Software Engineer, Automation" />
    <noscript>This site runs best with JavaScript enabled.</noscript>
    <script type="application/ld+json">
      [{ "@context": "http://schema.org", "@type": "WebSite", "url": "https://dustindavis.me", "name": "Dustin Davis", "alternateName": "About Dustin Davis" }]
    </script>
    <meta name="theme-color" content="#c2461d" />
    <link rel="apple-touch-icon" sizes="192x192" href="/favicons/android-chrome-192x192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/favicons/android-chrome-512x512.png" />
    <link rel="alternate" type="application/rss+xml" title="Dustin Davis Blog RSS Feed" href="/blog/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  </head>
  <body>
    <div class="page-shell">
      {% include "header.njk" %}
      <main class="page-main">
        {% if fullWidth %}
          <div class="wrap wrap-wide">
            {% block content_wide %}{{ content | safe }}{% endblock %}
          </div>
        {% else %}
          <div class="prose">
            {{ content | safe }}
          </div>
        {% endif %}
      </main>
      {% include "footer.njk" %}
    </div>
    <script src="/static/site.js" defer></script>
  </body>
</html>
