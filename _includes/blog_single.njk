<!DOCTYPE html>
<html lang="en" data-theme="light">
  {% set bannerPath = page.inputPath | directoryPath + '/' + banner %}
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <!-- No-flash theme: apply saved / preferred theme before paint -->
    <script>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YTTL61KN8J"></script>
    <script type="text/javascript">
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-YTTL61KN8J');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..600&family=JetBrains+Mono:ital,wght@0,400..800;1,400..600&display=swap" rel="stylesheet" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/lazysizes/5.3.2/lazysizes.min.js" async></script>

    <link rel="stylesheet" href="/static/site.css" />

    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{{ title }} — Dustin Davis</title>
    <meta name="keywords" content="" />
    <meta name="description" content="{{ description }}" />

    <meta name="image" content="https://dustindavis.me{% metaImage bannerPath %}" />
    <meta property="og:url" content="https://dustindavis.me{{ page.url }}" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:image" content="https://dustindavis.me{% metaImage bannerPath %}" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@DustinDavis" />
    <meta name="twitter:title" content="{{ title }}" />
    <meta name="twitter:description" content="{{ description }}" />
    <meta name="twitter:image" content="https://dustindavis.me{% metaImage bannerPath %}" />

    <noscript>This site runs best with JavaScript enabled.</noscript>
    <meta name="theme-color" content="#c2461d" />
    <link rel="apple-touch-icon" sizes="192x192" href="/favicons/android-chrome-192x192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/favicons/android-chrome-512x512.png" />
    <link rel="alternate" type="application/rss+xml" title="Dustin Davis Blog RSS Feed" href="/blog/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  </head>
  <body>
    <div class="page-shell">
      {% include "header.njk" %}

      <main class="page-main">
        <article class="post wrap">
          <header class="post__header">
            <div class="section__label">
              <span class="prompt">$</span> <span class="cmd">cat</span> ~/blog/{{ page.fileSlug }}.md
            </div>

            <div class="post__meta">
              {% if categories %}
                <div class="post__tags">
                  {% for category in categories %}
                    <span class="blog-category tag-static">{{ category }}</span>
                  {% endfor %}
                </div>
              {% endif %}
              <time datetime="{{ date | date('yyyy-LL-dd') }}">{{ date | date("LLLL dd, yyyy") }}</time>
            </div>

            <h1 class="post__title">{{ title }}</h1>
            {% if description %}<p class="post__deck">{{ description }}</p>{% endif %}
          </header>

          <div class="post__body prose">
            {% responsiveImage bannerPath, title, "blog-banner-image" %}
            {% if bannerCredit %}
              <div class="post__credit">{{ bannerCredit | markdown | safe }}</div>
            {% endif %}
            {{ content | safe }}
          </div>

          <footer class="post__footer">
            <p class="post__updated">
              Last updated
              <a href="https://github.com/djedi/dustindavis.me/commits/master/{{ page.inputPath }}">
                {{ date | date("EEEE, LLLL dd, yyyy") }}
              </a>
            </p>

            <div class="post__ctas">
              <a class="promo promo--eb" href="https://envelopebudget.com" target="_blank" rel="noopener noreferrer">
                <span class="promo__head">
                  <img src="/images/eb.png" alt="" />
                  <span class="promo__brand">EnvelopeBudget</span>
                </span>
                <span class="promo__title">Simple budgeting that works</span>
                <span class="promo__desc">Digital envelopes for the modern age. Set it aside, spend it, and stop wondering where it went.</span>
                <span class="promo__cta">Try it free</span>
              </a>
              <a class="promo promo--rs" href="https://redseam.com" target="_blank" rel="noopener noreferrer">
                <span class="promo__head">
                  <img src="/images/rs.png" alt="" />
                  <span class="promo__brand">Red Seam</span>
                </span>
                <span class="promo__title">Need a website, app, or automation?</span>
                <span class="promo__desc">Custom software and workflows built around how you actually work.</span>
                <span class="promo__cta">Let's talk</span>
              </a>
            </div>

            <div class="post__share">
              <span>Share article</span>
              <a href="https://x.com/intent/tweet?url={{ 'https://dustindavis.me' + page.url | urlencode }}&text={{ title | urlencode }} via @DustinDavis" target="_blank" rel="noopener" aria-label="Share on X/Twitter">𝕏</a>
              <a href="https://www.facebook.com/sharer/sharer.php?u=https://dustindavis.me{{ page.url }}" target="_blank" rel="noopener" aria-label="Share on Facebook">Facebook</a>
            </div>

            <div class="post__author">
              <img src="/images/dustin.avif" alt="Dustin Davis" />
              <div>
                <strong>Dustin Davis</strong> is a software engineer who loves to build. He lives in a small rural Utah town, is taking up gardening as a hobby, and is determined to grow his own food.
              </div>
            </div>
          </footer>
        </article>

        <div class="post__discuss wrap">
          <script defer src="https://commento.davis.im/js/commento.js"></script>
          <div id="commento"></div>

          <p class="post__discuss-links">
            <a target="_blank" rel="noopener noreferrer" href="https://mobile.x.com/search?q=https%3A%2F%2Fdustindavis.me{{ page.url | urlencode }}">Discuss on 𝕏</a>
            <span class="post__discuss-sep">•</span>
            <a target="_blank" rel="noopener noreferrer" href="{{ page.inputPath | githubPath }}">Edit post on GitHub</a>
          </p>
        </div>
      </main>

      {% include "footer.njk" %}
    </div>
    <script src="/static/site.js" defer></script>
  </body>
</html>
